+    def pin_prefix(self) -> int:
+        """Pin the longest prefix chain (deepest leaf to root) so it is
+        never evicted. Call after warm-up to make the CC prefix permanent.
+        Returns the number of pinned nodes.
+        """
+        if self.disable:
+            return 0
+        core = self.tree_core
+        # DFS to find the deepest node (longest token path from root).
+        deepest = core.root_node
+        max_depth = 0
+        stack = [(core.root_node, 0)]
+        while stack:
+            node, depth = stack.pop()
+            if depth > max_depth:
+                max_depth = depth
+                deepest = node
+            for child in node.children.values():
+                klen = len(child.key) if child.key else 0
+                stack.append((child, depth + klen))
+        if deepest is core.root_node:
+            return 0
+        # Walk up from deepest to root, pinning each node.
+        count = 0
+        node = deepest
+        while node is not None and node.parent is not None:
+            node.pinned = True
+            for component in core.components:
+                cd = node.component_data[component.component_type]
+                if cd.lock_ref < 1:
+                    cd.lock_ref = 1
+                    if cd.value is not None:
+                        key_len = len(cd.value)
+                        core.component_evictable_size_[component.component_type] -= key_len
+                        core.component_protected_size_[component.component_type] += key_len
+                if cd.host_lock_ref < 1:
+                    cd.host_lock_ref = 1
+            core._update_evictable_leaf_sets(node)
+            count += 1
+            node = node.parent
+        return count
