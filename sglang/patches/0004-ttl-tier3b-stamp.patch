+    def _ttl_secs_for_usage(self, usage: float) -> int:
+        # watermark bands -> retention TTL (retention shrinks as pool fills)
+        if usage < 0.35:
+            return 43200  # hot band (25-35%): 12h
+        if usage < 0.75:
+            return 14400  # session band: 4h
+        if usage < 0.80:
+            return 1800  # >75%: 30min countdown
+        if usage < 0.90:
+            return 300  # >80%: 5min countdown
+        return 0  # >90%: immediate reclaim
+
+    def _ttl_stamp(self, node, promote: bool = False) -> None:
+        """Stamp/refresh tier + expire_at (TTLWatermarkStrategy reads
+        both via getattr). promote=True upgrades a re-hit shared prefix
+        to tier 2 (evicted last). No-op unless ttl_watermark is on.
+        """
+        if not self.ttl_watermark_enabled:
+            return
+        try:
+            if promote and getattr(node, "tier", 1) < 2:
+                node.tier = 2
+            node.expire_at = time.monotonic() + self._ttl_secs_for_usage(
+                self._ttl_token_usage()
+            )
+        except Exception:
+            pass
