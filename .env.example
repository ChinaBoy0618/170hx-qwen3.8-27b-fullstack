# 170HX-Qwen3.8-27B-fullstack — 环境变量模板
# 复制为 .env 并填入真值；.env 不入 git（见 .gitignore）
# 所有 ${VAR:?} 形式的脚本在缺失时会报错退出，不会静默降级

# ---------- SGLang 推理层 (4 卡) ----------
# SGLang 服务鉴权 key（launch-awq.sh 的 --api-key）
SGLANG_API_KEY=sk-your-sglang-api-key-here
# 权重路径（宿主机）
SGLANG_MODEL_PATH=/mnt/data/models/eff-awq-w4a16/NVFP4/AWQ-W4A16
# DFLASH draft 权重路径
SGLANG_DRAFT_PATH=/mnt/data/models/Qwen3.8-27B-DFlash2
# 推理参数（与 760 生产对齐；改动前先看 TUNING.md）
SGLANG_CTX_LEN=262144
SGLANG_HICACHE_RATIO=1.0
SGLANG_CHUNK_PREFILL=8192
SGLANG_MEM_FRACTION=0.9
SGLANG_KV_CACHE_DTYPE=fp8_e4m3
SGLANG_DRAFT_KV_CACHE_DTYPE=fp8_e4m3
SGLANG_TOK_WORKERS=4
# L3 文件缓存（可选；SGLANG_L3=0 关闭）
SGLANG_L3=1
SGLANG_L3_DIR_BASE=/mnt/nvme-kv/kv-l3
SGLANG_L3_MAX_GB=100G
# 镜像 tag（01-build-sglang.sh 产出后使用）
SGLANG_IMG=sglang:dflash2-fullstack
# 容器端口基址（卡 0..3 → 5800..5803）
SGLANG_BASE_PORT=5800
# CC 前缀自暖开关（1=双暖+pin，0=关）
WARM_CC=1

# ---------- SMG 网关 ----------
GATEWAY_PORT=30010
GATEWAY_PROM_PORT=29010

# ---------- new-api ----------
NEWAPI_PORT=3001
# new-api 调用方 API key（打 /v1/messages 用）
NEWAPI_KEY=nk-your-newapi-key-here
# 上游指向（默认走 SMG 网关）
NEWAPI_UPSTREAM=http://127.0.0.1:30010

# ---------- 监控栈 ----------
PROM_PORT=9090
GRAFANA_PORT=3000
MONITORING_CONF_DIR=/mnt/data/observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
# 飞书告警 webhook（feishu-watch 用；占位勿写真值）
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK_ID
