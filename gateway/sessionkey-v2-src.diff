-/// Build the cache_aware routing text for an Anthropic Messages body: the
-/// concatenation of every text-bearing block across `system` and all
-/// `messages` (text, tool_use, tool_result, thinking). Mirrors what
-/// `extract_text_for_routing` does for OpenAI chat bodies — the *full*
-/// conversation, not just the first message, so KV-prefix affinity stays
-/// meaningful for multi-turn sessions (see sglang #26263). Returns `None`
-/// when there is no text to route on.
-fn extract_anthropic_messages_text(parsed: &serde_json::Value) -> Option<String> {
-    fn block_text_into(out: &mut String, block: &serde_json::Value) {
-        match block.get("type").and_then(|t| t.as_str()) {
-            Some("text") => {
-                if let Some(t) = block.get("text").and_then(|t| t.as_str()) {
-                    out.push_str(t);
-                    out.push('\n');
-                }
-            }
-            Some("tool_use") => {
-                if let Some(t) = block.get("name").and_then(|t| t.as_str()) {
-                    out.push_str(t);
-                    out.push_str(":");
-                }
-                if let Some(inp) = block.get("input") {
-                    out.push_str(&inp.to_string());
-                    out.push('\n');
-                }
-            }
-            Some("tool_result") => {
-                if let Some(c) = block.get("content") {
-                    if c.is_string() {
-                        out.push_str(c.as_str().unwrap_or(""));
-                    } else if let Some(arr) = c.as_array() {
-                        for item in arr {
-                            block_text_into(out, item);
-                        }
-                    }
-                    out.push('\n');
-                }
-            }
-            Some("thinking") => {
-                if let Some(t) = block.get("thinking").and_then(|t| t.as_str()) {
-                    out.push_str(t);
-                    out.push('\n');
-                }
-            }
-            _ => {}
-        }
-    }
-
-    let mut out = String::new();
-
-    // `system` may be a plain string or an array of content blocks
-    if let Some(system) = parsed.get("system") {
-        if system.is_string() {
-            out.push_str(system.as_str().unwrap_or(""));
-            out.push('\n');
-        } else if let Some(arr) = system.as_array() {
-            for block in arr {
-                block_text_into(&mut out, block);
-            }
-        }
-    }
-
-    if let Some(messages) = parsed.get("messages").and_then(|m| m.as_array()) {
-        for msg in messages {
-            if let Some(content) = msg.get("content") {
-                if content.is_string() {
-                    out.push_str(content.as_str().unwrap_or(""));
-                    out.push('\n');
-                } else if let Some(blocks) = content.as_array() {
-                    for block in blocks {
-                        block_text_into(&mut out, block);
-                    }
-                }
-            }
-        }
-    }
-
-    if out.is_empty() {
-        None
-    } else {
-        Some(out)
-    }
-}
