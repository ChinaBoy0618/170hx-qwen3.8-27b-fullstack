-/// Middleware to validate an Anthropic client against the configured API key.
-///
-/// Accepts either `Authorization: Bearer <key>` or `x-api-key: <key>`:
-/// Anthropic-native clients (and the new-api `anthropic` channel adaptor)
-/// authenticate with `x-api-key`, which the Bearer-only `auth_middleware`
-/// would reject with 401. Same constant-time comparison semantics as
-/// `auth_middleware`; with no API key configured the request is let through.
-pub async fn auth_middleware_anthropic(
-    State(auth_config): State<AuthConfig>,
-    request: Request<Body>,
-    next: Next,
-) -> Result<Response, StatusCode> {
-    if let Some(expected_key) = &auth_config.api_key {
-        let bearer = request
-            .headers()
-            .get(header::AUTHORIZATION)
-            .and_then(|h| h.to_str().ok())
-            .and_then(|v| v.strip_prefix("Bearer "));
-
-        let x_api_key = request
-            .headers()
-            .get("x-api-key")
-            .and_then(|h| h.to_str().ok());
-
-        let token = match bearer.or(x_api_key) {
-            Some(t) => t,
-            None => return Err(StatusCode::UNAUTHORIZED),
-        };
-
-        let token_bytes = token.as_bytes();
-        let expected_bytes = expected_key.as_bytes();
-        if token_bytes.len() != expected_bytes.len() {
-            return Err(StatusCode::UNAUTHORIZED);
-        }
-        if token_bytes.ct_eq(expected_bytes).unwrap_u8() != 1 {
-            return Err(StatusCode::UNAUTHORIZED);
-        }
-    }
-
-    Ok(next.run(request).await)
-}
